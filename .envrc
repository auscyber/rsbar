#!/bin/sh
# devenv cannot see the working directory through a flake, so hand it one: this
# writes the real path where `flake.nix`'s `devenv-root` input can read it.
# See https://devenv.sh/guides/using-with-flakes/
mkdir -p "$(dirname "$0")/.devenv"
printf '%s' "$PWD" > "$PWD/.devenv/root"
use flake . --override-input devenv-root "file+file://$PWD/.devenv/root"
